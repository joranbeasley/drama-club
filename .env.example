# Postgres connection string
DATABASE_URL=postgres://dramaclub:dramaclub@localhost:5432/dramaclub

# Google sign-in: create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your site
# (e.g. http://localhost:3000) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Who may sign in (comma separated). Leave both empty to let anyone with a Google account in.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Local development without Google: sign in with any email. Ignored when NODE_ENV=production.
DEV_LOGIN=1

PORT=3000
# NODE_ENV=production
# SESSION_DAYS=30
# MAX_BODY=20mb
